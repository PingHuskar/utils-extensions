{
  "manifest_version": 3,
  "name": "Easy Copy",
  "version": "1.0.0",
  "description": "Select, right-click and copy text on blog sites that block copying. Adds a Copy button for selections and paragraphs.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Easy Copy"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
