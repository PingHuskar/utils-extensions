{
  "manifest_version": 3,
  "name": "Repo QR",
  "version": "1.0.0",
  "description": "Shows a QR code for a GitHub repository's About website.",
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["qr-generator.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
